# PostgreSQL (для docker-compose)
POSTGRES_USER=party
POSTGRES_PASSWORD=замените-на-случайную-строку
POSTGRES_DB=party_db

# Prisma
DATABASE_URL="postgresql://party:замените-на-случайную-строку@localhost:5432/party_db"
DIRECT_URL="postgresql://party:замените-на-случайную-строку@localhost:5432/party_db"

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=замените-на-длинную-случайную-строку
APP_URL="http://localhost:3000"

# SMTP (опционально)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your@gmail.com"
