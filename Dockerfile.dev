FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
COPY server/prisma ./server/prisma/

RUN npm ci

RUN npx prisma generate --schema=server/prisma/schema.prisma

COPY . .

EXPOSE 5173 3000

CMD ["sh", "-c", "npx prisma migrate deploy --schema=server/prisma/schema.prisma && npx tsx watch server/src/index.ts & npx vite --host 0.0.0.0"]
